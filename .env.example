# Copia este archivo a .env y ajusta las rutas.
#
# Rutas de los binarios, por configuracion (Fase 4). Vacias = se usan los del
# PATH, que es lo normal en un VPS o en Docker (docs/MIGRAR_WORKER.md).
# YT_DLP_PATH y YTDLP_PATH (el nombre de siempre) valen los dos.
#
# En Windows conviene fijarlas, y absolutas a proposito. Tras instalar yt-dlp por
# winget quedaron DOS ffmpeg en el PATH: el build full de gyan.dev (que trae el
# filtro whisper y NVENC) y el que yt-dlp arrastra como dependencia (que no los
# trae). Depender del orden del PATH haria que el pipeline fallara de forma
# intermitente e inexplicable. Se fija la ruta y se acaba el problema.

FFMPEG_PATH=C:\Users\TU-USUARIO\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.1-full_build\bin\ffmpeg.exe
FFPROBE_PATH=C:\Users\TU-USUARIO\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.1-full_build\bin\ffprobe.exe
YT_DLP_PATH=C:\Users\TU-USUARIO\AppData\Local\Microsoft\WinGet\Packages\yt-dlp.yt-dlp_Microsoft.Winget.Source_8wekyb3d8bbwe\yt-dlp.exe

# Modelo ggml de whisper.cpp. Relativo a la raiz del proyecto.
WHISPER_MODEL_PATH=models/ggml-large-v3-turbo.bin

# Modelo VAD. Muy recomendado: sin el, el filtro segmenta por ventanas de reloj
# y parte palabras en cada frontera. Con VAD segmenta por pausas del habla.
# Origen: repositorio ggml-org/whisper-vad en Hugging Face.
WHISPER_VAD_MODEL_PATH=models/ggml-silero-v5.1.2.bin

# --- yt-dlp -----------------------------------------------------------------
#
# YouTube rechaza con 403 las descargas anonimas de los formatos de alta calidad.
# Medido en este proyecto sobre un video de 87 minutos:
#
#   player_client por defecto -> HTTP 403 Forbidden al descargar el medio
#   tv                        -> "The page needs to be reloaded"
#   web_safari / ios / web    -> "Requested format is not available"
#   mweb                      -> FUNCIONA, pero solo expone el formato 18 (360p)
#
# 360p basta para transcribir (el audio es AAC 44 kHz y whisper remuestrea a 16 kHz),
# pero NO para renderizar vertical 1080x1920. Para obtener 1080p hay que
# autenticarse con las cookies del navegador.
YTDLP_EXTRACTOR_ARGS=youtube:player_client=mweb

# Navegador del que tomar las cookies de sesion: chrome, edge, firefox, brave...
# Dejar VACIO para no tocar el navegador.
#
# ATENCION: las cookies son credenciales. Activar esto le da a yt-dlp acceso a tu
# sesion de YouTube. Tiene sentido para descargar contenido propio de tu canal;
# piensalo dos veces para cualquier otra cosa.
YTDLP_COOKIES_FROM_BROWSER=

# Selector de formato. El primero que exista, gana.
YTDLP_FORMAT=bv*[height>=1080]+ba/bv*[ext=mp4]+ba[ext=m4a]/bv*+ba/b[ext=mp4]/b

# Directorios de trabajo, relativos a la raiz del proyecto.
WORK_DIR=work
OUT_DIR=out

# --- IA: elegir momentos -------------------------------------------------------
#
# Por defecto con Claude Code y TU SUSCRIPCION, sin clave de API (docs/IA.md).
# El trabajador lanza `claude -p` en este PC; hace falta haber iniciado sesion
# una vez: abrir `claude` y escribir /login.
#
#   claude-cli     la suscripcion (por defecto)
#   anthropic-api  la API de pago, con ANTHROPIC_API_KEY
#   ollama         un modelo local (calidad insuficiente, ver provider.ts)
LLM_PROVIDER=claude-cli

# Ejecutable de Claude Code. Vacio = `claude` del PATH.
CLAUDE_CLI_PATH=

# Modelo: sonnet (calidad, por defecto), opus, haiku (tareas simples) o un
# nombre completo. "Probar IA" usa LLM_MODEL_PRUEBA (por defecto haiku).
LLM_MODEL=sonnet
LLM_MODEL_PRUEBA=haiku

# Tiempo maximo por llamada, en milisegundos. Pasado, se mata el proceso.
LLM_TIMEOUT_MS=180000

# Hasta cuantos caracteres de transcripcion van en UNA sola llamada. Un video
# de hora y media ronda 100.000. Si no cabe, se parte en bloques de una hora.
LLM_MAX_CARACTERES=300000

# Solo con LLM_PROVIDER=anthropic-api. NO hace falta con la suscripcion: el
# trabajador la quita del entorno de Claude Code para que no la use.
ANTHROPIC_API_KEY=

# Modelo de seleccion. Por defecto el mas capaz: esta es la pieza que decide si
# el producto funciona, y el coste por VOD es de centimos frente al de renderizar
# y publicar 60 clips diarios. Alternativas: claude-sonnet-5, claude-haiku-4-5.
# Mide la calidad antes de bajar de nivel.
SELECT_MODEL=claude-opus-5-5

# Profundidad de razonamiento: low | medium | high | max
SELECT_EFFORT=high

# --- Fase 6: publicacion ------------------------------------------------------
# Proveedor verificado: upload-post, plan Professional (50 USD/mes, 25 perfiles,
# subidas ilimitadas). Alternativas comparadas: bundle.social (100 USD, cuentas
# ilimitadas) y Ayrshare (149 USD, 14 cuentas por perfil, no cubre el caso).
UPLOAD_POST_API_KEY=

# direct = publica en el perfil sin intervencion. Es lo unico compatible con un
#          sistema desatendido.
# draft  = deja el video en borradores y alguien lo publica desde la app.
#          Los proveedores afirman que da mas alcance organico, pero con 20
#          cuentas y 3 publicaciones diarias son 60 acciones manuales al dia.
PUBLISH_MODE=direct

# --- Alternativa local para la Fase 2: Ollama ---------------------------------
# Si OLLAMA_MODEL tiene valor, la seleccion usa el modelo LOCAL y NO llama a la
# API de Anthropic, aunque ANTHROPIC_API_KEY este configurada. Es un interruptor,
# no un respaldo: deja la variable vacia para volver a Anthropic.
#
# Coste cero y sin depender de saldo, a cambio de peor calidad de seleccion, que
# es justo la pieza que decide si el producto funciona. Mide antes de fiarte.
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434

# --- Fase 7: copias de revision en la nube ------------------------------------
#
# El panel vive en un servidor y los MP4 en este ordenador, asi que desde el
# movil no se veia ningun video. Con esto se sube una COPIA LIGERA de cada clip
# (540x960, algo mas de un mega) para poder revisarlos desde cualquier sitio.
#
# NO se sube el master. Medido sobre los clips reales: 30,34 MB el master contra
# 1,13 MB la copia, 27 veces menos. Los 33 que hay ocupan 1127 MB en master y 37
# en copia; el plan gratuito de Storage es 1 GB, asi que subir masters no cabria.
# El master se queda aqui, que es de donde se publica.
#
# La clave es la service_role de Supabase: Project Settings -> API -> service_role.
# SALTA LAS POLITICAS DE ACCESO POR DISEÑO. Da control total sobre los datos del
# proyecto, asi que no la pongas en ningun sitio publico ni en el codigo.
#
# Hace falta en DOS sitios:
#   1. Aqui, para que `npm run subir` pueda subir las copias.
#   2. En las variables de entorno del panel en Hostinger, para que pueda firmar
#      las URLs temporales con las que el navegador pide cada video.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: solo si la URL del proyecto no se puede deducir de DATABASE_URL.
# Por defecto se saca del usuario de Postgres (postgres.<ref> -> <ref>.supabase.co).
SUPABASE_URL=

# --- Fase 6b: publicacion por la API directa de TikTok -------------------------
#
# Alternativa a upload-post. Sin cuota mensual, pero la app tiene que pasar la
# auditoria de TikTok: hasta entonces todo lo que publique queda en privado
# (SELF_ONLY) y no lo ve nadie. Comprueba en que punto estas con:
#
#   npm run tiktok -- revisar
#
# Que proveedor se usa al publicar de verdad. Si no se pone, upload-post.
# No se adivina mirando que credenciales hay: durante una migracion estan las
# dos, y elegir sola significaria publicar por donde no esperas.
PUBLISH_PROVIDER=upload-post

# De tu app en https://developers.tiktok.com  ->  Manage apps  ->  tu app.
# El client_key son 16 caracteres y el secret 32.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Direccion de retorno del flujo de autorizacion. TIENE QUE SER EXACTAMENTE la
# misma que registres en la app de TikTok, y con https: TikTok rechaza http
# incluso en pruebas.
#
# Es una ruta del panel, la unica que atiende sin la llave (?k=...), porque
# quien llega es el navegador siguiendo una redireccion de tiktok.com. Lo que
# la protege es un `state` de un solo uso que caduca en una hora.
TIKTOK_REDIRECT_URI=https://TU-PANEL.hostingersite.com/auth/tiktok/callback

# --- Paginas legales ----------------------------------------------------------
#
# El panel sirve /legal/terminos y /legal/privacidad en publico, sin llave:
# TikTok las exige para auditar la app y quien las revisa no tiene credenciales.
#
# ESTOS TRES DATOS VAN VACIOS A PROPOSITO. Inventar una razon social o una
# jurisdiccion seria poner datos falsos en un documento legal. Mientras falten,
# las paginas salen con un aviso naranja de "borrador sin completar", que es
# preferible a publicar algo que no es cierto.
LEGAL_TITULAR=
LEGAL_PAIS=

# Correo de contacto para ejercer derechos y para avisos de copyright. Si se
# deja vacio se usa OWNER_EMAIL.
LEGAL_EMAIL=

# --- Despliegue a Hostinger -------------------------------------------------
#
# Donde publica `npm run desplegar`. Antes estaban escritos dentro del guion,
# lo que significaba que cualquiera que clonara el repositorio desplegaba al
# servidor de quien lo escribio.
#
# El dominio es el que da Hostinger al sitio (algo-algo-123456.hostingersite.com
# o el tuyo propio) y el usuario es el de la cuenta de hosting, visible en
# hPanel. El token va aparte, mas arriba, y no se comparte con nadie.
HOSTINGER_DOMINIO=
HOSTINGER_USUARIO=


# --- Acceso al panel (Fase 2) -------------------------------------------------
#
# Se entra con correo y contraseña. El primer administrador se crea con
#   npm run crear-admin -- correo@ejemplo.com "Nombre"
# y el resto desde el panel (Ajustes > Usuarios). No hay registro publico.

# Clave de servicio para programas que llamen al panel (nunca personas), en la
# cabecera "Authorization: Bearer <clave>". Minimo 32 caracteres al azar, por
# ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vacia = desactivada. Hoy el trabajador no la necesita: habla con la base.
WORKER_TOKEN=

# Transicion: la llave antigua (?k=...) y REVIEW_PASSWORD siguen valiendo SOLO
# con esto en true. Cuando el login este confirmado, quitarlo, borrar
# REVIEW_KEY y REVIEW_PASSWORD, y ROTAR la llave: se compartio en un chat.
LEGACY_KEY_ENABLED=false
REVIEW_KEY=
REVIEW_PASSWORD=

# Solo para la vista previa de desarrollo: sin login, y el panel escucha
# unicamente en 127.0.0.1. Nunca en Hostinger.
KLIP_SIN_LOGIN=

# --- Alertas (Fase 7) -------------------------------------------------------
# Las manda el PANEL: si el procesador se cae, alguien de fuera tiene que
# avisar. Basta con uno de los dos destinos; vacios = sin alertas.
# Telegram: crea un bot con @BotFather, escribele una vez y pon aqui su token
# y el id de tu chat (o de un grupo donde este el bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Correo por la API de resend.com. PARA admite varias direcciones con comas.
RESEND_API_KEY=
ALERTAS_CORREO_PARA=
ALERTAS_CORREO_DE=

# --- Enlaces de descarga firmados (Fase 8) ---------------------------------
# Secreto con el que el panel firma los enlaces de descarga (caducan en 24 h).
# Minimo 32 caracteres al azar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vacio = uno al azar en cada arranque: los enlaces dejan de valer al reiniciar.
ENLACES_SECRETO=
